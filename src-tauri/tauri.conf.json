{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot Renamer",
  "version": "0.1.34",
  "identifier": "com.kahlil.yee.screenshotrenamer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screenshot Renamer",
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "kmyee97",
    "homepage": "https://github.com/kmyee97/Screenshot-Renamer",
    "shortDescription": "Descriptive screenshot filenames with safe rename and undo.",
    "longDescription": "A Windows screenshot utility with local OCR, optional cloud analysis, naming presets, history, undo, and unobtrusive tray controls.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
